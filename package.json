{
  "name": "orderpilot",
  "version": "0.1.0",
  "private": true,
  "description": "OrderPilot: customer PO intake, validation and approval for wholesalers and distributors.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3000",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:concurrency": "node scripts/dev/assert-local-db.mjs && vitest run --config vitest.concurrency.config.ts",
    "test:e2e": "playwright test --config playwright.preview.config.ts && playwright test --config playwright.production.config.ts",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:app": "playwright test --config playwright.app.config.ts",
    "check": "eslint --max-warnings=0 . && tsc --noEmit && vitest run && NEXT_TELEMETRY_DISABLED=1 next build",
    "db:start": "SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase start -x realtime,imgproxy,studio,edge-runtime,logflare,vector,supavisor",
    "db:stop": "SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase stop",
    "db:status": "SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase status",
    "db:reset": "node scripts/dev/assert-local-db.mjs && SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase db reset --local",
    "db:test": "node scripts/dev/assert-local-db.mjs && SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase test db --local",
    "db:types": "SUPABASE_TELEMETRY_DISABLED=1 DO_NOT_TRACK=1 supabase gen types typescript --local --schema public > src/server/db/database.types.ts && prettier --write src/server/db/database.types.ts",
    "db:env": "node scripts/dev/write-env.mjs",
    "db:provision": "node scripts/dev/provision-users.mjs",
    "ops:reset-mfa": "node scripts/ops/reset-mfa.mjs",
    "ops:reset-demo": "node scripts/ops/reset-demo.mjs",
    "perf:check": "node scripts/dev/perf-check.mjs",
    "ai:check": "node scripts/dev/ai-check.mjs"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
