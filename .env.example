# OrderPilot environment variables. Names and meaning only; never commit values.
# Locally, `corepack pnpm db:env` writes .env.local (git-ignored) for you.

# --- Supabase (public: safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=            # https://<project-ref>.supabase.co in deployed environments
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only ---
SUPABASE_SECRET_KEY=                 # service role; read only by src/server/privileged
APP_BASE_URL=                        # public URL of the app, used in invitation and reset links
INTERNAL_JOB_SECRET=                 # 32+ random bytes (hex); authenticates the worker route
DEPLOYMENT_ENV=production            # local | test | staging | production; fixtures are recognised only in local/test and demo workspaces

# --- Email ---
MAIL_TRANSPORT=mailpit               # local only; a real provider is approved separately (D-25)
MAILPIT_URL=http://127.0.0.1:54324   # local only

# --- AI extraction (server only; never NEXT_PUBLIC_) ---
AI_EXTRACTION_PROVIDER=simulated     # simulated (fictional fixtures, no AI calls) | gemini
GEMINI_API_KEY=                      # from Google AI Studio; set only in .env.local or the host's secret settings
GEMINI_MODEL=gemini-3.8-flash        # any Gemini model that accepts PDFs and images
# GEMINI_BASE_URL=                   # tests only: points the provider at a mock server
AI_MAX_REQUESTS_PER_MINUTE=5         # all workspaces together; extra jobs wait in the queue
AI_MAX_REQUESTS_PER_DAY=100          # all workspaces together, rolling 24 hours
AI_MAX_REQUESTS_PER_WORKSPACE_PER_DAY=50
AI_MAX_PAGES=15                      # larger documents go to manual entry without an AI call
AI_MAX_DOCUMENT_BYTES=10485760       # 10 MB
AI_REQUEST_TIMEOUT_MS=90000          # shorter than the worker's 120-second lease
