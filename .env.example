# OrderPilot environment variables (names only; never commit real values).
# Phase 1 needs no environment variables. The development preview uses
# fictional fixtures only and has no backend connection.
#
# Added in Phase 2 (see docs/TECHNICAL_ARCHITECTURE.md §7.4):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=          # server only, privileged modules only
# INTERNAL_JOB_SECRET=          # server only
# EXTRACTION_PROVIDER=simulated
# APP_BASE_URL=
